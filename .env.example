# Mit npm run admin:password erzeugen. Das Passwort selbst gehört nicht hierher.
BASALIC_ADMIN_PASSWORD_HASH=

# Im Betrieb: dauerhaftes, privates Verzeichnis mit Schreibrechten für den Node-Prozess.
BASALIC_DATA_DIR=.basalic-data

# Lokal leer lassen. Im Betrieb die genaue HTTPS-Adresse ohne Pfad eintragen.
BASALIC_SITE_ORIGIN=

# Kontaktformular. API-Schlüssel und bestätigte Absenderadresse nur am Server setzen.
BASALIC_CONTACT_RESEND_API_KEY=
BASALIC_CONTACT_FROM=

# Optional ein gemeinsames Postfach statt Immobilien-, Finanzierungs- und allgemeiner Adresse nutzen.
BASALIC_CONTACT_TO=

# Optional die HTTPS-Origin einer statischen Vorschau erlauben, z. B. https://pascalgri.github.io.
BASALIC_CONTACT_ALLOWED_ORIGIN=
