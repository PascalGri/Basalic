# Mit npm run admin:password erzeugen. Das Passwort selbst gehört nicht hierher.
BASALIC_ADMIN_PASSWORD_HASH=

# Im Betrieb: dauerhaftes, privates Verzeichnis mit Schreibrechten für den Node-Prozess.
BASALIC_DATA_DIR=.basalic-data

# Lokal leer lassen. Im Betrieb die genaue HTTPS-Adresse ohne Pfad eintragen.
BASALIC_SITE_ORIGIN=
