{
  "name": "basalic-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5104 --strictPort",
    "build": "node scripts/prepare-media.mjs && vite build && node scripts/prepare-media.mjs --page-heads",
    "preview": "vite preview --host 127.0.0.1 --port 5104 --strictPort",
    "start": "node server/index.mjs",
    "admin:password": "node scripts/admin-password.mjs",
    "check": "node scripts/check.mjs",
    "check:admin": "node scripts/check-admin.mjs"
  },
  "dependencies": {
    "@fontsource/geist": "^5.2.8",
    "@phosphor-icons/core": "^2.1.1",
    "cheerio": "^1.1.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "vite": "^7.3.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
